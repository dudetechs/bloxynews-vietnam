CREATE TABLE IF NOT EXISTS x_sources (
  id            INTEGER PRIMARY KEY AUTOINCREMENT,
  username      TEXT NOT NULL UNIQUE COLLATE NOCASE,
  user_id       TEXT,
  display_name  TEXT,
  enabled       INTEGER NOT NULL DEFAULT 1,
  last_since_id TEXT,
  last_sync_at  TEXT,
  last_error    TEXT,
  created_at    TEXT NOT NULL DEFAULT (datetime('now'))
);

CREATE TABLE IF NOT EXISTS x_posts (
  id              INTEGER PRIMARY KEY AUTOINCREMENT,
  post_id         TEXT NOT NULL UNIQUE,
  source_id       INTEGER REFERENCES x_sources(id) ON DELETE SET NULL,
  author_username TEXT NOT NULL,
  author_name     TEXT NOT NULL,
  text            TEXT NOT NULL,
  created_at      TEXT,
  url             TEXT NOT NULL,
  media_json      TEXT NOT NULL DEFAULT '[]',
  status          TEXT NOT NULL DEFAULT 'pending'
                  CHECK (status IN ('pending','approved','rejected','archived')),
  category        TEXT CHECK (category IS NULL OR category IN ('news','updates','games','studio','vietnam')),
  imported_at     TEXT NOT NULL DEFAULT (datetime('now')),
  reviewed_at     TEXT
);

CREATE INDEX IF NOT EXISTS idx_x_posts_status_created ON x_posts (status, created_at DESC);

